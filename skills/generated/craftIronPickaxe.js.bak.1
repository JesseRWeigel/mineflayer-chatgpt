async function craftIronPickaxe(bot) {
  const { goals } = require('mineflayer-pathfinder');
  const mcData = require('minecraft-data')(bot.version);

  const ironOre = bot.findBlock({ matching: mcData.blocksByName.iron_ore.id, distance: 64 });
  if (!ironOre) throw new Error("Cannot find iron_ore nearby");

  const coal = bot.findBlock({ matching: mcData.blocksByName.coal_ore.id, distance: 64 });
  if (!coal) throw new Error("Cannot find coal nearby");

  const craftingTable = bot.findBlock({ matching: mcData.blocksByName.crafting_table.id, distance: 64 });
  if (!craftingTable) throw new Error("Cannot find crafting_table nearby");

  const ironIngotsCount = bot.inventory.count(mcData.itemsByName.iron_ingot.id);
  const sticksCount = bot.inventory.count(mcData.itemsByName.stick.id);

  if (ironIngotsCount < 3) {
    await bot.pathfinder.goto(new goals.GoalBlock(ironOre.position.x, ironOre.position.y, ironOre.position.z));
    await bot.dig(ironOre);
    await bot.pathfinder.goto(new goals.GoalNear(ironOre.position.x, ironOre.position.y, ironOre.position.z, 1));
    await bot.pathfinder.goto(new goals.GoalBlock(coal.position.x, coal.position.y, coal.position.z));
    await bot.dig(coal);
    await bot.pathfinder.goto(new goals.GoalNear(coal.position.x, coal.position.y, coal.position.z, 1));
    await smeltItem(bot, "iron_ore", "coal", 3 - ironIngotsCount);
  }

  if (sticksCount < 2) {
    await craftItem(bot, "stick", 1);
  }

  await bot.pathfinder.goto(new goals.GoalNear(craftingTable.position.x, craftingTable.position.y, craftingTable.position.z, 1));
  const recipes = bot.recipesFor(mcData.itemsByName.iron_pickaxe.id, null, 1, craftingTable);
  if (!recipes || recipes.length === 0) throw new Error("No recipe found for iron_pickaxe");
  await bot.craft(recipes[0], 1, craftingTable);
  bot.chat("Crafted an iron pickaxe.");
}