async function craftFurnace(bot) {
  const { goals } = require('mineflayer-pathfinder');
  const furnaceId = bot.registry.itemsByName.furnace.id;
  if (bot.inventory.items().some(item => item.type === furnaceId)) return;
  const craftingTable = bot.findBlock({ matching: b => b.name === 'crafting_table', maxDistance: 32 });
  if (!craftingTable) throw new Error('Cannot find crafting_table nearby');
  await bot.pathfinder.goto(new goals.GoalNear(craftingTable.position.x, craftingTable.position.y, craftingTable.position.z, 2));
  const recipes = await bot.recipesFor(furnaceId, null, 1, craftingTable);
  if (!recipes || recipes.length === 0) throw new Error('Cannot find furnace recipe nearby');
  await bot.craft(recipes[0], 1, craftingTable);
  if (bot.inventory.items().some(item => item.type === furnaceId)) {
    await bot.placeBlock(craftingTable, {x:0,y:1,z:0});
  } else {
    const drop = bot.findBlock({ matching: b => b.name === 'furnace', maxDistance: 32 });
    if (!drop) throw new Error('Cannot find furnace drop nearby');
    await bot.pathfinder.goto(new goals.GoalNear(drop.position.x, drop.position.y, drop.position.z, 2));
    await bot.dig(drop);
    await bot.pathfinder.goto(new goals.GoalNear(drop.position.x, drop.position.y, drop.position.z, 0.5));
  }
}