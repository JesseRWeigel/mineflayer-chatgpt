async function craftAStonePickaxeUsingAvailableMaterial(bot) {
  const mcData = require('minecraft-data')(bot.version);
  const { itemsByName } = mcData;
  const { goals } = require('mineflayer-pathfinder');

  const cobblestoneItems = bot.inventory.items().filter(i => i.name === 'cobblestone');
  const stickItems = bot.inventory.items().filter(i => i.name === 'stick');

  if (cobblestoneItems.reduce((s, i) => s + i.count, 0) < 3) {
    throw new Error('Not enough cobblestone — need 3');
  }
  if (stickItems.reduce((s, i) => s + i.count, 0) < 2) {
    throw new Error('Not enough sticks — need 2');
  }

  const craftingTable = bot.findBlock({
    matching: b => b.name === 'crafting_table',
    maxDistance: 32
  });

  if (!craftingTable) throw new Error('No crafting table nearby — place one first');

  await bot.pathfinder.goto(new goals.GoalNear(craftingTable.position.x, craftingTable.position.y, craftingTable.position.z, 2));

  const stonePickaxe = itemsByName.stone_pickaxe;
  const recipes = bot.recipesFor(stonePickaxe.id, null, 1, craftingTable);

  if (!recipes.length) throw new Error('No stone pickaxe recipe found — missing materials?');

  await bot.craft(recipes[0], 1, craftingTable);

  const pickaxe = bot.inventory.items().find(i => i.name === 'stone_pickaxe');
  if (!pickaxe) throw new Error('Craft appeared to succeed but no stone_pickaxe in inventory');
  await bot.equip(pickaxe, 'hand');
}